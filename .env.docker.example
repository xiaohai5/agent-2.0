# Copy this file to .env on the server, then fill in real secrets.

APP_PORT=80

MYSQL_DATABASE=agent
MYSQL_USER=agent
MYSQL_PASSWORD=change-this-agent-password
MYSQL_ROOT_PASSWORD=change-this-root-password

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

AMAP_MCP_URL=https://mcp.amap.com/mcp?key=your-amap-key
TICKET_MCP_ARGS=-y,12306-mcp

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-2.0
